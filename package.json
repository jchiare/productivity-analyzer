  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "electron": "^39.2.7"
  },
  "devDependencies": {"@electron/rebuild": "^3.7.1"}
}
