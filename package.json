{
  "name": "productivity-tracker",
  "version": "1.0.0",
  "description": "A macOS menu bar app that tracks active window information and generates AI-powered productivity insights",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dashboard": "node scripts/quick-dashboard.js && open reports/dashboard.html",
